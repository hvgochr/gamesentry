#!/usr/bin/env bash
set -euo pipefail
umask 077

APP_DIR=/srv/gamesentry
BACKUP_DIR=/srv/backups/gamesentry
LOCK_FILE="$APP_DIR/.ops.lock"

cd "$APP_DIR"

# Use the same persistent inode and advisory lock as the deployment workflow.
# Do not delete, rename or replace this lock file.
exec 9<> "$LOCK_FILE"
flock -w 900 9 || { echo 'Timed out waiting for GameSentry operations lock.' >&2; exit 1; }

# Shell variables take precedence over Compose --env-file interpolation.
# The deployed image must come from .env.deploy, not a caller's environment.
unset GAMESENTRY_IMAGE || true

compose() {
  docker compose \
    --env-file .env.production \
    --env-file .env.deploy \
    -p gamesentry \
    -f compose.prod.yaml \
    "$@"
}

install -d -m 700 "$BACKUP_DIR"

timestamp="$(date -u +%Y-%m-%d_%H-%M-%S)"
backup_file="$BACKUP_DIR/gamesentry-${timestamp}-$$.dump"
tmp_file="$(mktemp "$BACKUP_DIR/.gamesentry-${timestamp}.XXXXXXXX.tmp")"

cleanup() {
  rm -f -- "$tmp_file"
}
trap cleanup EXIT

echo 'Creating GameSentry PostgreSQL backup...'
compose exec -T postgres pg_dump -U gamesentry -d gamesentry -Fc > "$tmp_file"

test -s "$tmp_file"

echo 'Checking PostgreSQL dump archive catalogue...'
compose exec -T postgres pg_restore --list < "$tmp_file" > /dev/null

chmod 600 "$tmp_file"
mv -- "$tmp_file" "$backup_file"
echo "Backup created: $backup_file"

# Retention applies only after a successful dump and archive-catalogue check.
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'gamesentry-*.dump' -mtime +7 -delete

echo 'GameSentry backup complete.'
